{
  "name": "google-voice-tray",
  "version": "1.0.0",
  "description": "Google Voice System Tray App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.googlevoice.trayapp",
    "productName": "Google Voice Tray",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GoogleVoiceTray.exe"
    },
    "files": [
      "main.js",
      "preload.js"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
